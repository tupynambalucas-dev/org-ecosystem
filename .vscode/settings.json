{
  "search.useIgnoreFiles": false,
  "search.useGlobalIgnoreFiles": false,
  "search.useParentIgnoreFiles": false,
  "search.exclude": {
    "**/node_modules": true,
    "**/.pnpm-store": true,
    "**/.git": true,
    "**/dist": true,
    "**/.turbo": true
  },
  "files.exclude": {
    "**/.git": false
  },
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.pnpm-store/**": true,
    "**/dist/**": true
  }
}
