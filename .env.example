# ============================================================================== #
#                 org-ecosystem - ENVIRONMENT CONFIGURATION TEMPLATE             #
# ============================================================================== #
#                                                                                #
#  This template centralizes configuration variables, credentials, and runtime   #
#  toggles used across the Tupynamba Lucas Product Ecosystem meta-repository.    #
#                                                                                #
#  INSTRUCTIONS:                                                                 #
#  1. Copy this file to .env in your active workspace (e.g. org-ecosystem/.env). #
#  2. Never commit .env to version control (.gitignore enforces this invariant). #
#  3. Populate placeholders (<YOUR_*>) with your local workstation values.       #
#                                                                                #
# ============================================================================== #


# ------------------------------------------------------------------------------ #
# 1. GITHUB MACHINE IDENTITY & REPOSITORY GOVERNANCE
# ------------------------------------------------------------------------------ #

# -- GitHub Organization Identifier
GITHUB_ORG=tupynambalucas-dev

# -- Tier 1: tupynambalucas-org-manager (Administrative Headless Machine Identity)
ORG_MANAGER_APP_ID=<YOUR_ORG_MANAGER_APP_ID>
ORG_MANAGER_APP_CLIENT_ID=<YOUR_ORG_MANAGER_APP_CLIENT_ID>
ORG_MANAGER_APP_INSTALLATION_ID=<YOUR_ORG_MANAGER_APP_INSTALLATION_ID>
ORG_MANAGER_APP_PRIVATE_KEY_BASE64=<YOUR_ORG_MANAGER_APP_PRIVATE_KEY_BASE64>
ORG_MANAGER_APP_PRIVATE_KEY_PATH=<YOUR_ORG_MANAGER_APP_PRIVATE_KEY_PATH>

# -- Tier 2: tupynambalucas-ci-bot (Autonomous Continuous Delivery Identity)
CI_BOT_APP_ID=<YOUR_CI_BOT_APP_ID>
CI_BOT_APP_CLIENT_ID=<YOUR_CI_BOT_APP_CLIENT_ID>
CI_BOT_APP_INSTALLATION_ID=<YOUR_CI_BOT_APP_INSTALLATION_ID>
CI_BOT_APP_PRIVATE_KEY_BASE64=<YOUR_CI_BOT_APP_PRIVATE_KEY_BASE64>
CI_BOT_APP_PRIVATE_KEY_PATH=<YOUR_CI_BOT_APP_PRIVATE_KEY_PATH>

# -- Tier 3: tupynambalucas-developer-tools (Developer Workstation Identity)
DEVELOPER_TOOLS_CLIENT_ID=Ov23lizK8i9R5h9x0b2c


# ------------------------------------------------------------------------------ #
# 2. SECRETS & CLOUD VAULT (INFISICAL UNIVERSAL AUTH)
# ------------------------------------------------------------------------------ #

INFISICAL_API_URL=https://app.infisical.com
INFISICAL_PROJECT_ID=<YOUR_INFISICAL_PROJECT_ID>
INFISICAL_CLIENT_ID=<YOUR_INFISICAL_CLIENT_ID>
INFISICAL_CLIENT_SECRET=<YOUR_INFISICAL_CLIENT_SECRET>
INFISICAL_ENVIRONMENT=dev


# ------------------------------------------------------------------------------ #
# 3. AI AGENT MESH & MCP RUNTIME CONFIGURATION
# ------------------------------------------------------------------------------ #

AGENT_MESH_LOG_LEVEL=info
PLAYWRIGHT_MODE=auto
