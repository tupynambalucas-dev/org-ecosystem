{
  "folders": [
    {
      "name": "org-ecosystem (Ecosystem Orchestrator)",
      "path": "."
    },
    {
      "name": "omnichannel (Commercial SaaS Monorepo)",
      "path": "commercial/omnichannel"
    },
    {
      "name": "tessel (Proprietary Enterprise Monorepo)",
      "path": "internal/tessel"
    }
  ],
  "settings": {
    "git.autoRepositoryDetection": true,
    "search.useIgnoreFiles": false,
    "search.useGlobalIgnoreFiles": false,
    "search.useParentIgnoreFiles": false,
    "search.exclude": {
      "**/node_modules": true,
      "**/.pnpm-store": true,
      "**/.git": true,
      "**/dist": true,
      "**/.turbo": true
    },
    "files.exclude": {
      "**/.git": false
    },
    "files.watcherExclude": {
      "**/.git/objects/**": true,
      "**/.git/subtree-cache/**": true,
      "**/node_modules/**": true,
      "**/.pnpm-store/**": true,
      "**/dist/**": true
    }
  },
  "extensions": {
    "recommendations": [
      "bradlc.vscode-tailwindcss",
      "d-koppenhagen.file-tree-to-text-generator",
      "dbaeumer.vscode-eslint",
      "emanuelebartolesi.taskdeck",
      "esbenp.prettier-vscode",
      "github.vscode-github-actions",
      "redhat.vscode-yaml",
      "shd101wyy.markdown-preview-enhanced",
      "unifiedjs.vscode-mdx"
    ]
  },
  "tasks": {
    "version": "2.0.0",
    "tasks": [
      {
        "label": "Antigravity CLI (Ecosystem Scope)",
        "type": "process",
        "command": "wt.exe",
        "windows": {
          "command": "wt.exe",
          "args": [
            "-d",
            "${workspaceFolder:org-ecosystem (Ecosystem Orchestrator)}",
            "powershell.exe",
            "-NoExit",
            "-Command",
            "agy"
          ]
        },
        "problemMatcher": []
      },
      {
        "label": "Mani: Sync Repositories",
        "type": "shell",
        "command": "mani sync",
        "problemMatcher": []
      },
      {
        "label": "Mani: Check Git Status",
        "type": "shell",
        "command": "mani run status",
        "problemMatcher": []
      },
      {
        "label": "Mani: Pull All Main",
        "type": "shell",
        "command": "mani run pull",
        "problemMatcher": []
      }
    ]
  }
}
